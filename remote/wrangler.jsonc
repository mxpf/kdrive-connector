/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kdrive-connector-mcp",
  "main": "src/index.ts",
  "version_metadata": { "binding": "KDRIVE_WORKER_VERSION" },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public"
  },
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  /**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 * 
	 * Commands to set secrets:
   * npx wrangler secret put GITHUB_CLIENT_ID
   * npx wrangler secret put GITHUB_CLIENT_SECRET
   * npx wrangler secret put COOKIE_ENCRYPTION_KEY
   * npx wrangler secret put KDRIVE_ACCESS_TOKEN
	 * npx wrangler secret put KDRIVE_OPERATION_SECRET
   */
  "vars": {
    // OCR requires an explicit per-call opt-in and remains bounded on Workers Free.
    "KDRIVE_PDF_OCR_ENABLED": "true",
    "KDRIVE_MAX_BINARY_BYTES": "104857600",
    "KDRIVE_BINARY_SOURCE_HOSTS": "files.oaiusercontent.com,sandbox.openai.com,sdmntprcentralus.oaiusercontent.com,sdmntprnorthcentralus.oaiusercontent.com,sdmntprsoutheastus3.oaiusercontent.com,sdmntpreastus2.oaiusercontent.com,oaisdmntprnorthcentralus.blob.core.windows.net,sdmntprbrazilsouth.oaiusercontent.com,sdmntprsouthcentralus.oaiusercontent.com,sdmntprwestus.oaiusercontent.com,sdmntprnortheu.oaiusercontent.com,sdmntprwestus2.oaiusercontent.com,sdmntprcacentral.oaiusercontent.com,archive.org,dn760102.eu.archive.org,ia600901.us.archive.org,ia800901.us.archive.org",
		"ALLOWED_GITHUB_LOGIN": "mxpf",
		"KDRIVE_CONNECTOR_BASE_URL": "https://kdrive-connector-mcp.maxpfennighaus.workers.dev",
		"KDRIVE_MAX_READ_BYTES": "2097152",
    "KDRIVE_MAX_UPLOAD_BYTES": "10485760"
  },
  "migrations": [
    {
      "new_sqlite_classes": ["KDriveMCP"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["KDriveOperationNonceStore"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["KDriveBinaryDigestStore"],
      "tag": "v3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "KDriveMCP",
        "name": "MCP_OBJECT"
      },
      {
        "class_name": "KDriveOperationNonceStore",
        "name": "KDRIVE_OPERATION_NONCES"
      },
      {
        "class_name": "KDriveBinaryDigestStore",
        "name": "KDRIVE_BINARY_DIGESTS"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "161a2f4016044bd689ce566cbf935116"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "dev": {
    "port": 8788
  }
}
