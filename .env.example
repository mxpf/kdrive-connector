# Required by the MCP server. This is the numeric ID shown in the kDrive URL.
INFOMANIAK_DRIVE_ID=

# Optional: required only for an OAuth application authorised for kDrive.
INFOMANIAK_CLIENT_ID=
INFOMANIAK_CLIENT_SECRET=
INFOMANIAK_REDIRECT_URI=http://127.0.0.1:53682/callback
INFOMANIAK_OAUTH_SCOPE=drive

# Optional environment-token alternative; prefer `npm run token:save` so the
# token is stored outside the repository and does not remain in shell history.
# INFOMANIAK_ACCESS_TOKEN=long-lived-personal-api-token

# Optional storage locations and safety limits.
# KDRIVE_TOKEN_FILE=/absolute/path/to/tokens.json
# KDRIVE_MAX_READ_BYTES=2097152
# KDRIVE_MAX_UPLOAD_BYTES=10485760
